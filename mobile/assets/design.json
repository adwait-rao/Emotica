{
  "designSystem": {
    "name": "Emotica Design System",
    "version": "1.0.0",
    "description": "AI companion app for journaling and mental wellbeing",
    "theme": {
      "primary": "mental-health",
      "approach": "calming-therapeutic",
      "personality": "supportive-empathetic"
    },
    "colors": {
      "primary": {
        "50": "#E8F5E8",
        "100": "#C8E6C9",
        "200": "#A5D6A7",
        "300": "#81C784",
        "400": "#66BB6A",
        "500": "#4CAF50",
        "600": "#43A047",
        "700": "#388E3C",
        "800": "#2E7D32",
        "900": "#1B5E20",
        "main": "#4CAF50",
        "dark": "#388E3C",
        "light": "#81C784"
      },
      "secondary": {
        "50": "#F1F8E9",
        "100": "#DCEDC8",
        "200": "#C5E1A5",
        "300": "#AED581",
        "400": "#9CCC65",
        "500": "#8BC34A",
        "600": "#7CB342",
        "700": "#689F38",
        "800": "#558B2F",
        "900": "#33691E",
        "main": "#8BC34A",
        "dark": "#689F38",
        "light": "#AED581"
      },
      "neutral": {
        "50": "#FAFAFA",
        "100": "#F5F5F5",
        "200": "#EEEEEE",
        "300": "#E0E0E0",
        "400": "#BDBDBD",
        "500": "#9E9E9E",
        "600": "#757575",
        "700": "#616161",
        "800": "#424242",
        "900": "#212121",
        "white": "#FFFFFF",
        "black": "#000000"
      },
      "semantic": {
        "success": "#4CAF50",
        "warning": "#FF9800",
        "error": "#F44336",
        "info": "#2196F3"
      },
      "mood": {
        "happy": "#4CAF50",
        "neutral": "#9E9E9E",
        "sad": "#607D8B",
        "anxious": "#FF9800",
        "calm": "#81C784"
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "Inter",
        "secondary": "Poppins",
        "script": "Dancing Script",
        "fallback": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      },
      "scale": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem"
      },
      "styles": {
        "heading": {
          "fontFamily": "Inter",
          "fontWeight": "700",
          "fontSize": "2.25rem",
          "lineHeight": "1.2",
          "color": "#388E3C",
          "letterSpacing": "-0.025em"
        },
        "heading2": {
          "fontFamily": "Inter",
          "fontWeight": "600",
          "fontSize": "1.875rem",
          "lineHeight": "1.3",
          "color": "#388E3C",
          "letterSpacing": "-0.025em"
        },
        "mood": {
          "fontFamily": "Dancing Script",
          "fontWeight": "400",
          "fontSize": "1.5rem",
          "lineHeight": "1.4",
          "color": "#4CAF50",
          "fontStyle": "italic"
        },
        "body": {
          "fontFamily": "Inter",
          "fontWeight": "400",
          "fontSize": "1rem",
          "lineHeight": "1.6",
          "color": "#424242"
        },
        "caption": {
          "fontFamily": "Inter",
          "fontWeight": "500",
          "fontSize": "0.875rem",
          "lineHeight": "1.4",
          "color": "#757575"
        }
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem"
    },
    "borderRadius": {
      "none": "0",
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "2xl": "1.5rem",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
    },
    "components": {
      "buttons": {
        "primary": {
          "backgroundColor": "#4CAF50",
          "color": "#FFFFFF",
          "borderRadius": "2rem",
          "padding": "0.75rem 2rem",
          "fontSize": "1rem",
          "fontWeight": "600",
          "border": "none",
          "boxShadow": "0 4px 6px -1px rgba(76, 175, 80, 0.3)",
          "transition": "all 0.2s ease-in-out",
          "hover": {
            "backgroundColor": "#43A047",
            "transform": "translateY(-1px)",
            "boxShadow": "0 6px 8px -1px rgba(76, 175, 80, 0.4)"
          }
        },
        "secondary": {
          "backgroundColor": "transparent",
          "color": "#4CAF50",
          "borderRadius": "2rem",
          "padding": "0.75rem 2rem",
          "fontSize": "1rem",
          "fontWeight": "600",
          "border": "2px solid #4CAF50",
          "transition": "all 0.2s ease-in-out",
          "hover": {
            "backgroundColor": "#4CAF50",
            "color": "#FFFFFF"
          }
        },
        "row": {
          "backgroundColor": "transparent",
          "color": "#4CAF50",
          "borderRadius": "2rem",
          "padding": "0.75rem 1.5rem",
          "fontSize": "1rem",
          "fontWeight": "500",
          "border": "2px solid #4CAF50",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "space-between",
          "minWidth": "200px"
        },
        "icon": {
          "backgroundColor": "#4CAF50",
          "color": "#FFFFFF",
          "borderRadius": "50%",
          "width": "3rem",
          "height": "3rem",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "border": "none",
          "fontSize": "1.5rem"
        },
        "fab": {
          "backgroundColor": "#4CAF50",
          "color": "#FFFFFF",
          "borderRadius": "50%",
          "width": "4rem",
          "height": "4rem",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "border": "none",
          "fontSize": "1.5rem",
          "boxShadow": "0 4px 12px rgba(76, 175, 80, 0.4)",
          "position": "fixed",
          "bottom": "2rem",
          "right": "2rem"
        }
      },
      "inputs": {
        "dropdown": {
          "backgroundColor": "#4CAF50",
          "color": "#FFFFFF",
          "borderRadius": "2rem",
          "padding": "0.75rem 1.5rem",
          "fontSize": "1rem",
          "fontWeight": "500",
          "border": "none",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "space-between",
          "minWidth": "200px"
        },
        "textArea": {
          "backgroundColor": "#FFFFFF",
          "color": "#424242",
          "borderRadius": "1rem",
          "padding": "1rem",
          "fontSize": "1rem",
          "fontWeight": "400",
          "border": "2px solid #E0E0E0",
          "minHeight": "120px",
          "resize": "vertical",
          "fontFamily": "Inter"
        }
      },
      "toggles": {
        "switch": {
          "width": "4rem",
          "height": "2rem",
          "borderRadius": "2rem",
          "backgroundColor": "#E0E0E0",
          "position": "relative",
          "transition": "all 0.3s ease",
          "active": {
            "backgroundColor": "#4CAF50"
          },
          "thumb": {
            "width": "1.5rem",
            "height": "1.5rem",
            "borderRadius": "50%",
            "backgroundColor": "#FFFFFF",
            "position": "absolute",
            "top": "0.25rem",
            "left": "0.25rem",
            "transition": "all 0.3s ease",
            "boxShadow": "0 2px 4px rgba(0, 0, 0, 0.2)"
          }
        }
      },
      "cards": {
        "main": {
          "backgroundColor": "#FFFFFF",
          "borderRadius": "1.5rem",
          "padding": "2rem",
          "boxShadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
          "border": "1px solid #F5F5F5",
          "position": "relative"
        },
        "mood": {
          "backgroundColor": "#E8F5E8",
          "borderRadius": "1.5rem",
          "padding": "1.5rem",
          "boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
          "border": "1px solid #C8E6C9"
        }
      },
      "avatars": {
        "user": {
          "width": "3rem",
          "height": "3rem",
          "borderRadius": "50%",
          "backgroundColor": "#81C784",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "overflow": "hidden"
        },
        "mood": {
          "width": "3rem",
          "height": "3rem",
          "borderRadius": "50%",
          "backgroundColor": "#4CAF50",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "overflow": "hidden"
        },
        "assistant": {
          "width": "3rem",
          "height": "3rem",
          "borderRadius": "50%",
          "backgroundColor": "#388E3C",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "overflow": "hidden"
        }
      },
      "chatBubbles": {
        "user": {
          "backgroundColor": "#E8F5E8",
          "color": "#2E7D32",
          "borderRadius": "1.5rem 1.5rem 0.5rem 1.5rem",
          "padding": "1rem 1.5rem",
          "fontSize": "1rem",
          "fontFamily": "Inter",
          "maxWidth": "75%",
          "alignSelf": "flex-end",
          "marginLeft": "auto"
        },
        "assistant": {
          "backgroundColor": "#4CAF50",
          "color": "#FFFFFF",
          "borderRadius": "1.5rem 1.5rem 1.5rem 0.5rem",
          "padding": "1rem 1.5rem",
          "fontSize": "1rem",
          "fontFamily": "Inter",
          "maxWidth": "75%",
          "alignSelf": "flex-start",
          "marginRight": "auto"
        }
      },
      "charts": {
        "line": {
          "backgroundColor": "#4CAF50",
          "borderRadius": "1rem",
          "padding": "1.5rem",
          "strokeColor": "#FFFFFF",
          "strokeWidth": "3px",
          "pointColor": "#FFFFFF",
          "pointRadius": "6px",
          "gridColor": "rgba(255, 255, 255, 0.2)"
        },
        "progress": {
          "backgroundColor": "#81C784",
          "borderRadius": "1rem",
          "padding": "1.5rem",
          "barColor": "#2E7D32",
          "height": "1rem"
        }
      },
      "navigation": {
        "slider": {
          "backgroundColor": "#4CAF50",
          "borderRadius": "2rem",
          "padding": "0.5rem",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "space-between",
          "minWidth": "300px"
        },
        "controls": {
          "backgroundColor": "rgba(255, 255, 255, 0.2)",
          "borderRadius": "50%",
          "width": "2.5rem",
          "height": "2.5rem",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "color": "#FFFFFF",
          "border": "none"
        }
      },
      "indicators": {
        "status": {
          "width": "1rem",
          "height": "1rem",
          "borderRadius": "50%",
          "backgroundColor": "#4CAF50",
          "display": "inline-block"
        },
        "notification": {
          "width": "0.75rem",
          "height": "0.75rem",
          "borderRadius": "50%",
          "backgroundColor": "#F44336",
          "position": "absolute",
          "top": "-0.25rem",
          "right": "-0.25rem"
        }
      }
    },
    "animations": {
      "duration": {
        "fast": "0.15s",
        "normal": "0.3s",
        "slow": "0.5s"
      },
      "easing": {
        "ease": "ease",
        "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
        "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
        "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)"
      }
    },
    "breakpoints": {
      "mobile": "320px",
      "tablet": "768px",
      "desktop": "1024px",
      "large": "1440px"
    },
    "accessibility": {
      "focusRing": "0 0 0 3px rgba(76, 175, 80, 0.5)",
      "minTouchTarget": "44px",
      "contrastRatio": "4.5:1"
    }
  }
}